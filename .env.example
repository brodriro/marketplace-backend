# Servidor
PORT=5000
NODE_ENV=development

# Postgres — ver docker-compose.yml para levantar una instancia local
DATABASE_URL="postgresql://marketplace:marketplace@localhost:5432/marketplace?schema=public"

# Secreto para firmar/verificar el JWT de acceso (HS256)
JWT_SECRET=
# TTL del access token (Bearer). Corto: el cliente rota con POST /auth/refresh
JWT_ACCESS_EXPIRES_IN=15m
# TTL del refresh token opaco (rotación por uso, revocación por familia)
JWT_REFRESH_EXPIRES_IN=30d

# Orígenes CORS permitidos (REST), separados por coma — dev server de admin/ (Next.js :3500) + agente A2A (:2500)
CORS_ORIGINS=http://localhost:3500,http://localhost:2500

# Usuario demo creado por el seed (prisma/seed.ts) — no hardcodear en código
SEED_DEMO_EMAIL=demo@marketplace.dev
SEED_DEMO_PASSWORD=demo12345

# Usuario admin creado por el seed (prisma/seed.ts) — no hardcodear en código
SEED_ADMIN_EMAIL=admin@marketplace.dev
SEED_ADMIN_PASSWORD=admin12345

# --- Pago (plan E2E §6.5 / hito M5) ---
# false (ventana M2→M4): POST /orders no crea intento de pago y vacía el carrito al crear.
# true (M5+): se crea el intento y el carrito se vacía en la transición a `paid`.
PAYMENTS_ENABLED=true
# Proveedor de pago. 'bypass' (default): NO cobra, entrega un clientSecret sintético y saltea la
# confirmación (POST /orders/:id/confirm marca `paid` sin verificar). Sirve para dev y el e2e.
# ⚠️ Cambiar a un proveedor real ANTES de friend&family / producción — ver documentacion/plan.md.
PAYMENT_PROVIDER=bypass
# Obligatorias sólo con PAYMENT_PROVIDER=stripe. Usar claves de TEST.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# Con PAYMENT_PROVIDER=stripe: habilita POST /orders/:id/confirm sin webhook real (demo/local).
# Con 'bypass' es irrelevante (el confirm siempre se acepta).
STRIPE_DEMO_CONFIRM=false
# Minutos en `pending_payment` antes de que el barrido cancele el pedido y reponga stock.
ORDER_PAYMENT_TTL_MIN=30
