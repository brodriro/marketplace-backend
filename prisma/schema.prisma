// Ver docs/plan-marketplace-backend.md §4 (demoCompose) para el diagrama ER y la justificación
// de cada decisión de modelado.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  Hot
  New
  Normal
  Popular
}

enum OrderStatus {
  pending_payment
  processing
  shipped
  delivered
}

enum StockAlertType {
  back_in_stock
  price_drop
}

enum Role {
  user
  admin
}

enum PromoCodeType {
  percentage
  fixed_amount
}

/**
 * Catálogo de valores válidos de color (§7 del plan) — no se referencia por FK desde `ProductVariant.color`, se valida en el DTO.
 */
model Color {
  id    String @id @default(uuid())
  name  String @unique
  value String

  @@map("colors")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  avatarUrl    String?
  role         Role     @default(user)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  favorites     Favorite[]
  orders        Order[]
  reviews       Review[]
  stockAlerts   StockAlert[]
  refreshTokens RefreshToken[]
  cart          Cart?

  @@map("users")
}

/**
 * Refresh token opaco (no JWT) del par de auth (plan E2E, hito M1). Se guarda solo el hash sha256
 * de `token` (nunca el valor en claro). `familyId` agrupa toda la cadena de rotaciones de un login:
 * presentar un token ya revocado (reuso) revoca la familia entera. `POST /auth/refresh` rota
 * (revoca el presentado, setea `replacedById`); `POST /auth/logout` y desactivar el usuario revocan
 * la familia. Un job aparte limpia los vencidos/revocados viejos.
 */
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Category {
  id       String  @id @default(uuid())
  name     String  @unique
  subtitle String?
  image    String?

  products Product[]

  @@map("categories")
}

model Product {
  id          String        @id @default(uuid())
  categoryId  String
  name        String
  description String
  image       String?
  price       Decimal       @db.Decimal(10, 2)
  store       String
  status      ProductStatus @default(Normal)
  visible     Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category    Category         @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  reviews     Review[]
  favorites   Favorite[]
  stockAlerts StockAlert[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  color     String
  sku       String  @unique
  stock     Int     @default(0)
  visible   Boolean @default(true)

  product    Product     @relation(fields: [productId], references: [id])
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([productId])
  @@map("product_variants")
}

/**
 * Carrito persistido por usuario (plan E2E, hito M2). Uno por usuario (`userId @unique`). Es la
 * fuente de verdad única para el carrito de la app nativa y del agente conversacional (que lo
 * consume vía proxy). El precio NO se guarda acá: `GET /cart` recalcula `unitPrice`/`lineTotal`/
 * `subtotal` con el `price` vigente del producto en cada request; se congela recién en `POST /orders`.
 */
model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id])
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  variantId String
  quantity  Int
  addedAt   DateTime @default(now())

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
  @@map("cart_items")
}

model Order {
  id           String      @id @default(uuid())
  userId       String
  status          OrderStatus @default(pending_payment)
  total           Decimal     @db.Decimal(10, 2)
  shippingCity    String
  etaDays         Int
  trackingNumber  String?
  trackingCarrier String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  variantId String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)

  order   Order          @relation(fields: [orderId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model Review {
  id        String   @id @default(uuid())
  productId String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([productId, userId])
  @@index([productId])
  @@map("reviews")
}

model Favorite {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@id([userId, productId])
  @@map("favorites")
}

model StockAlert {
  id        String         @id @default(uuid())
  userId    String
  productId String
  type      StockAlertType
  notified  Boolean        @default(false)
  createdAt DateTime       @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([userId])
  @@index([productId])
  @@map("stock_alerts")
}

/**
 * Registro de auditoría de acciones admin (plan E2E, hito M3). Una fila por mutación exitosa sobre
 * `/v1/admin/*` (POST/PATCH/DELETE), escrita por `AuditInterceptor`. `resource`/`action` son el
 * nombre de la clase controller y del handler (p. ej. `AdminProductsController` / `update`);
 * `changes` guarda el body del request. Solo lectura desde `GET /v1/admin/audit-logs`.
 */
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorEmail String?
  method     String
  path       String
  resource   String
  action     String
  entityId   String?
  statusCode Int
  changes    Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([resource, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/**
 * Banners promocionales — sin unique key porque una imagen puede reusarse entre campañas (ver
 * prisma/seed.ts, que por eso usa find-before-create en vez de upsert).
 * `active` y `visible` son independientes: `active` lo controla el admin (pausar/reactivar sin
 * perder el registro); `visible` es el borrado lógico (nunca se hace DELETE físico, ver
 * BannersService.remove) y no se expone para editar desde la UI.
 */
model Banner {
  id          String   @id @default(uuid())
  store       String
  description String
  image       String
  active      Boolean  @default(true)
  visible     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("banners")
}

/**
 * Códigos de descuento para la tool `apply_discount_code` del agente conversacional.
 * `appliesToCategory` guarda un `Category.id` pero NO es FK (mismo criterio que
 * `ProductVariant.color` frente a `Color`): no hay endpoint de escritura, solo `prisma/seed.ts`
 * puebla esta tabla y `GET /promo-codes/:code` es solo lectura/validación. El backend no aplica
 * el descuento en `POST /orders` — el total con descuento lo calcula el cliente.
 */
model PromoCode {
  id                String        @id @default(uuid())
  code              String        @unique
  type              PromoCodeType
  value             Decimal       @db.Decimal(10, 2)
  appliesToCategory String?
  minPurchase       Decimal       @default(0) @db.Decimal(10, 2)
  validFrom         DateTime
  validUntil        DateTime
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("promo_codes")
}
